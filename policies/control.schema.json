{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://productionos.dev/schemas/control-v2.json",
  "title": "ProductionOS control v2",
  "type": "object",
  "required": ["id", "version", "title", "domain", "severity", "trigger", "verification", "evidence", "rationale", "recommendation", "failureModes", "tradeoffs", "affectedFiles", "limitations", "falsePositiveBoundary"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": { "capabilities": { "type": "array", "items": { "type": "string" } } }
    },
    "verification": {
      "type": "array",
      "items": { "enum": ["static", "test", "runtime"] }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "artifact", "description"],
        "additionalProperties": false,
        "properties": {
          "method": { "enum": ["static", "test", "runtime"] },
          "artifact": { "enum": ["source_reference", "test_result", "runtime_observation"] },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "recommendation": { "type": "string", "minLength": 1 },
    "failureModes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "tradeoffs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "affectedFiles": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "falsePositiveBoundary": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
