{
  "name": "productionos",
  "version": "0.1.0",
  "description": "Evidence-driven production engineering for AI coding agents.",
  "license": "Apache-2.0",
  "author": "Hasnaat Hussain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hasnaathussain/productionos.git"
  },
  "bugs": {
    "url": "https://github.com/Hasnaathussain/productionos/issues"
  },
  "homepage": "https://github.com/Hasnaathussain/productionos#readme",
  "type": "module",
  "files": [
    "dist",
    "docs",
    "policies",
    "skills",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "prodos": "dist/apps/cli/src/main.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:unit": "npm run build && node scripts/run-tests.mjs",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "demo": "npm run build && node examples/run-demo.mjs",
    "release:check": "node scripts/release-check.mjs",
    "security:check": "node scripts/public-audit.mjs",
    "cli": "node dist/apps/cli/src/main.js",
    "format:check": "node scripts/check-format.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "typescript": "^5.9.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1"
  }
}
